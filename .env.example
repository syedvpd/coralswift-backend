# Coral Swift backend environment. Generated layout; one variable per line, no inline comments.
# .env is secret and gitignored. .env.example holds placeholders only.

# --- Application
APP_NAME=CoralSwift API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
PORTAL_BASE_URL=http://localhost:3000

# --- Database (SQLAlchemy URL, psycopg driver). Supabase: use the pooler host; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Authentication and security
SECRET_KEY=replace-with-random-value-of-at-least-48-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
STAFF_MFA_REQUIRED=true
MFA_ISSUER=CoralSwift
PASSWORD_MIN_LENGTH=12
PASSWORD_TIME_COST=2
PASSWORD_MEMORY_KIB=19456
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# --- Network protection (comma-separated lists)
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=12582912

# --- Private file storage. local = development; s3 = S3-compatible store (Supabase Storage S3 endpoint). These are STORAGE credentials, not database credentials.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_PARTNER_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_ENQUIRY=10

# --- Email. console = logs only, nothing is delivered; brevo = real delivery.
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Coral Swift
CAPTCHA_ENABLED=false

# Optional Redis cache (Render Key Value internal URL). Unset = no caching.
REDIS_URL=
CACHE_TTL_SECONDS=60
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
EMAIL_RECIPIENT_ALLOWLIST=
NOTIFICATION_MAX_RETRIES=5
NOTIFY_GENERAL_EMAILS=
NOTIFY_PROJECT_EMAILS=
NOTIFY_PARTNER_EMAILS=
NOTIFY_STRATEGIC_EMAILS=

# --- Public forms and compliance
PRIVACY_NOTICE_VERSION=draft-unapproved
IDEMPOTENCY_TTL_HOURS=24

# --- Local test database used ONLY by pytest and scripts/alembic_test_db.py (must be a local *_test database)
TEST_DATABASE_URL=postgresql+psycopg://coralswift:change-me-local-only@localhost:5433/coralswift_test

# --- docker-compose only (local PostgreSQL container and port mapping)
POSTGRES_USER=coralswift
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=coralswift
DB_HOST_PORT=5433
API_HOST_PORT=8000
